      <dc:title><rdf:Alt><rdf:li xml:lang="x-default">Personality Disorders</rdf:li></rdf:Alt></dc:title><dc:creator><rdf:Seq><rdf:li>Rainer Sachse</rdf:li></rdf:Seq></dc:creator></rdf:Description>
